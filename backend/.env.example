# Copy to .env and fill in what you need. Demo models work with no keys at all.

PORT=4000
# Comma-separated list of frontend URLs allowed to call the API.
FRONTEND_ORIGIN=http://localhost:3000

# Claude models (optional)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-4-5

# Any OpenAI-compatible endpoint, e.g. OpenAI, Groq, OpenRouter or a local Ollama (optional)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODELS=
OPENAI_COMPATIBLE_LABEL=
