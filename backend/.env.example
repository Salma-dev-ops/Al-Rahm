# Copy to .env and fill in what you need. Demo models work with no keys at all.

PORT=4000
# Comma-separated list of frontend URLs allowed to call the API.
FRONTEND_ORIGIN=http://localhost:3000
DB_PATH=./data/al-rahm.db
MODEL_TIMEOUT_MS=30000
EVALUATION_CONCURRENCY=3
MAX_ACTIVE_RUNS=3
# Optional for private integrations. Do not place this token in NEXT_PUBLIC_* variables.
# The current browser frontend expects this API on a trusted local/private network without a token.
API_AUTH_TOKEN=

# Claude models (optional)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-4-5

# Any OpenAI-compatible endpoint, e.g. OpenAI, Groq, OpenRouter or a local Ollama (optional)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODELS=
OPENAI_COMPATIBLE_LABEL=
