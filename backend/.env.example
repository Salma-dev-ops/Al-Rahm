# Copy to .env and fill in what you need. Everything works with no keys at all:
# example chatbots, mock M-Pesa payments and mock SMS.

PORT=4000
# Comma-separated list of frontend URLs allowed to call the API.
FRONTEND_ORIGIN=http://localhost:3000
# Public URL of the frontend, used for links in SMS messages.
APP_URL=http://localhost:3000
# Set to 1 when hosted behind a proxy (Render, Railway...) so rate limits see real client IPs.
# TRUST_PROXY=1

# ── Premium ──────────────────────────────────────────────
PREMIUM_PRICE_KES=500
PREMIUM_DAYS=30

# ── M-Pesa (Safaricom Daraja, STK Push) ──────────────────
# Leave blank for mock mode. Get sandbox keys at https://developer.safaricom.co.ke
# (create an app, then use the M-Pesa Express sandbox shortcode and passkey).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# A long random string. Safaricom's callbacks aren't signed, so the secret in the URL is
# what stops strangers faking payments.
MPESA_CALLBACK_SECRET=
# Must be a public https URL ending in /api/payments/mpesa/callback/<MPESA_CALLBACK_SECRET>.
# Locally, expose port 4000 with a tunnel such as ngrok and use that address.
MPESA_CALLBACK_URL=

# ── SMS (Africa's Talking) ───────────────────────────────
# Leave blank for mock mode (messages are only logged). Use AT_USERNAME=sandbox with your
# sandbox API key to see messages in the Africa's Talking simulator.
AT_USERNAME=
AT_API_KEY=
# AT_SENDER_ID=

# ── Models to evaluate (optional) ────────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-4-5

# Any OpenAI-compatible endpoint, e.g. OpenAI, Groq, OpenRouter or a local Ollama
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODELS=
OPENAI_COMPATIBLE_LABEL=
