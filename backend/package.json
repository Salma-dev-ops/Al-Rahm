    "test": "node --test",
    "demo": "node --env-file-if-exists=.env scripts/demo.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "cors": "^2.8.6",
    "express": "^5.3.0"
  }
}
