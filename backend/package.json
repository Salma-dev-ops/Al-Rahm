{
  "name": "al-rahm-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Al-Rahm evaluation API: runs women's health test cases against AI models and scores the answers.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env index.js",
